# Copy to .env and fill in. The .env file is never committed.
# Secrets used by upload and judge stages.
HF_TOKEN=replace-with-hub-token
GROQ_API_KEY=replace-with-groq-key
# Hub namespace (user or organization) that owns published repositories.
HF_NAMESPACE=replace-with-hub-namespace
# Remote machine used by make sync and make pull-results (ssh host alias and absolute directory).
REMOTE_HOST=replace-with-ssh-host-alias
REMOTE_DIR=replace-with-remote-directory
# Optional overrides.
# PLATFORM_ROOT=/path/to/large/storage
# LLAMA_CPP_DIR=/path/to/llama.cpp
# MLFLOW_TRACKING_URI=file:./mlruns
